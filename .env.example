# Copia este archivo a ".env.local" y ajusta los valores.

# URL base de la API del backend (Express, en el VPS)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del servidor de WebSocket (mismo backend) para el KDS en tiempo real
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- MCPs (opcionales; Figma / Exa / Firecrawl usan OAuth en Cursor) ---
# Si prefieres API key en vez de OAuth para Firecrawl (stdio), no la pongas aquí:
# configúrala en .cursor/mcp.json → env.FIRECRAWL_API_KEY (nunca la subas a git).
