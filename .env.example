# Copia este archivo a ".env.local" y ajusta los valores.

# URL base de la API. En local usa el backend de tu PC.
# En Vercel no definas esta variable: el sitio reenvía /api al VPS.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=418639014154-k5scmpabg2f8dvskktmah1iomt5oe68u.apps.googleusercontent.com

# URL del servidor de WebSocket (mismo backend) para el KDS en tiempo real
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Google Analytics 4 (solo producción). ID tipo G-XXXXXXXXXX
# Crea la propiedad en https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- MCPs (opcionales; Figma / Exa / Firecrawl usan OAuth en Cursor) ---
# Si prefieres API key en vez de OAuth para Firecrawl (stdio), no la pongas aquí:
# configúrala en .cursor/mcp.json → env.FIRECRAWL_API_KEY (nunca la subas a git).
